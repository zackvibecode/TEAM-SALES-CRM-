# Copy to .env.local for local dev.
# On Vercel: Project → Settings → Environment Variables.

# ─── Supabase (required) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Public app URLs ────────────────────────────────────────────────
# Marketing: WhatsApp or email for pricing CTAs (Hubungi Sales)
NEXT_PUBLIC_SALES_CONTACT_URL=https://wa.me/60XXXXXXXXX

# Public CRM URL for AI agents (use custom domain, not *.vercel.app preview)
NEXT_PUBLIC_CRM_BASE_URL=https://salescrm.zaqone.com

# ─── Agent / Hermes / MCP (server only — never NEXT_PUBLIC_) ────────
# Prefer Admin → MCP / ChatGPT to generate zaqone_... key in the dashboard.
# Optional env fallbacks:
#   CRM_API_KEY=
#   HERMES_AGENT_API_TOKEN=
#   CRM_MCP_OAUTH_SECRET=   # optional; defaults to derived secret from CRM key
CRM_API_KEY=

# ─── Upstash Redis (optional — app falls back to live DB if unset) ──
# Vercel: Marketplace → Upstash Redis, or: vercel integration add upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
